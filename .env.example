APP_CONFIG_PATH=config/default.json
PORT=5173
RUN_TURN_LIMIT=10
MODEL_CONFIG_PATH=config/model_configs.json
RUN_OUTPUT_DIR=runs
LATEST_COMPARISON_FILE=latest-comparison.json
DEMO_COMPARISON_FILE=demo-results.json

# Provider API keys. Only set the providers you plan to run.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional Supabase/Postgres-backed event streaming.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local Postgres from docker-compose, useful for manual schema inspection.
DATABASE_URL=postgres://cardio:cardio@localhost:5432/cardio_eval
