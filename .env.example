APP_CONFIG_PATH=config/default.json
PORT=5173
RUN_TURN_LIMIT=10
MODEL_CONFIG_PATH=config/model_configs.json
RUN_OUTPUT_DIR=runs
LATEST_COMPARISON_FILE=latest-comparison.json
DEMO_COMPARISON_FILE=demo-results.json

# Conversation engine. "llm" (default, from config/default.json) runs a real
# LLM patient conversing with the tested model, scored by an LLM judge. "scripted"
# uses the deterministic keyword patient + evaluator (offline, free, used by tests).
# Override per run with: node scripts/run-evaluation.js --engine scripted
EVAL_ENGINE=llm

# The LLM that role-plays the patient, and the LLM that judges elicitation.
# Both default to OpenAI gpt-5.4-mini (see config/default.json). Provider must be
# one of: openai, openrouter, anthropic (and its API key must be set below).
PATIENT_PROVIDER=openai
PATIENT_MODEL=gpt-5.4-mini
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-5.4-mini

# Provider API keys. Only set the providers you plan to run.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional Supabase/PostgREST-backed event streaming.
# SUPABASE_URL may be either https://<project-ref>.supabase.co
# or https://<project-ref>.supabase.co/rest/v1.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local Postgres from docker-compose, useful for manual schema inspection.
DATABASE_URL=postgres://cardio:cardio@localhost:5432/cardio_eval
